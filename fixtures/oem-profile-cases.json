{
  "_about": "Shared OEM profile cases. lib/oem.test.ts runs them against lib/oem.ts. The Phase 5 pytest for flight-mcp must run the same file, so the two validators cannot drift.",
  "_format": "Start from the lines of `base`. Each edit is applied in order. {replace, with} swaps the one line that equals `replace` exactly for `with` (use \\n for several lines, null to delete the line). {append} adds lines at the end. Then validate the result. `valid` is the expected outcome. Each string in `errors_mention` must appear in at least one error. `this_app_wrote` means the file must carry ORIGINATOR = 3ROK.",
  "base": "fixtures/minimal.oem",
  "cases": [
    {
      "name": "accepts the minimal fixture",
      "edits": [],
      "valid": true
    },
    {
      "name": "accepts another ORIGINATOR on a file this app did not write",
      "edits": [{ "replace": "ORIGINATOR = 3ROK", "with": "ORIGINATOR = NASA/JPL" }],
      "valid": true
    },
    {
      "name": "refuses an ORIGINATOR other than 3ROK on a file this app writes",
      "this_app_wrote": true,
      "edits": [{ "replace": "ORIGINATOR = 3ROK", "with": "ORIGINATOR = NASA/JPL" }],
      "valid": false,
      "errors_mention": ["ORIGINATOR", "3ROK"]
    },
    {
      "name": "refuses a wrong REF_FRAME",
      "edits": [{ "replace": "REF_FRAME = GCRF", "with": "REF_FRAME = EME2000" }],
      "valid": false,
      "errors_mention": ["REF_FRAME", "GCRF"]
    },
    {
      "name": "refuses a wrong CENTER_NAME",
      "edits": [{ "replace": "CENTER_NAME = EARTH", "with": "CENTER_NAME = MOON" }],
      "valid": false,
      "errors_mention": ["CENTER_NAME", "EARTH"]
    },
    {
      "name": "refuses a wrong TIME_SYSTEM",
      "edits": [{ "replace": "TIME_SYSTEM = UTC", "with": "TIME_SYSTEM = TAI" }],
      "valid": false,
      "errors_mention": ["TIME_SYSTEM", "UTC"]
    },
    {
      "name": "refuses a file with fewer than two states",
      "edits": [
        { "replace": "2026-10-03T18:20:00.000  -2120.0  -2440.0  6205.0  -3.10  6.55  2.40", "with": null },
        { "replace": "STOP_TIME = 2026-10-03T18:20:00.000", "with": "STOP_TIME = 2026-10-03T18:05:00.000" }
      ],
      "valid": false,
      "errors_mention": ["at least two"]
    },
    {
      "name": "refuses acceleration on some lines of a segment only",
      "edits": [
        {
          "replace": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10",
          "with": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10  0.001  0.002  0.003"
        }
      ],
      "valid": false,
      "errors_mention": ["Acceleration", "every state line"]
    },
    {
      "name": "accepts acceleration on every line of a segment",
      "edits": [
        {
          "replace": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10",
          "with": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10  0.001  0.002  0.003"
        },
        {
          "replace": "2026-10-03T18:20:00.000  -2120.0  -2440.0  6205.0  -3.10  6.55  2.40",
          "with": "2026-10-03T18:20:00.000  -2120.0  -2440.0  6205.0  -3.10  6.55  2.40  0.001  0.002  0.003"
        }
      ],
      "valid": true
    },
    {
      "name": "refuses a time that goes backwards inside a segment",
      "edits": [
        { "replace": "STOP_TIME = 2026-10-03T18:20:00.000", "with": "STOP_TIME = 2026-10-03T18:10:00.000" },
        { "append": "2026-10-03T18:10:00.000  -1500.0  -4000.0  4500.0  -2.00  5.00  4.00" }
      ],
      "valid": false,
      "errors_mention": ["must increase"]
    },
    {
      "name": "refuses INTERPOLATION without INTERPOLATION_DEGREE",
      "edits": [
        {
          "replace": "STOP_TIME = 2026-10-03T18:20:00.000",
          "with": "STOP_TIME = 2026-10-03T18:20:00.000\nINTERPOLATION = LINEAR"
        }
      ],
      "valid": false,
      "errors_mention": ["INTERPOLATION_DEGREE"]
    },
    {
      "name": "accepts INTERPOLATION with INTERPOLATION_DEGREE",
      "edits": [
        {
          "replace": "STOP_TIME = 2026-10-03T18:20:00.000",
          "with": "STOP_TIME = 2026-10-03T18:20:00.000\nINTERPOLATION = LINEAR\nINTERPOLATION_DEGREE = 1"
        }
      ],
      "valid": true
    },
    {
      "name": "refuses REF_FRAME_EPOCH on GCRF",
      "edits": [
        {
          "replace": "REF_FRAME = GCRF",
          "with": "REF_FRAME = GCRF\nREF_FRAME_EPOCH = 2000-01-01T12:00:00"
        }
      ],
      "valid": false,
      "errors_mention": ["REF_FRAME_EPOCH"]
    },
    {
      "name": "accepts a second segment after a discontinuity",
      "edits": [
        {
          "append": "META_START\nOBJECT_NAME = CASE-CHIPSET\nOBJECT_ID = UNKNOWN\nCENTER_NAME = EARTH\nREF_FRAME = GCRF\nTIME_SYSTEM = UTC\nSTART_TIME = 2026-10-03T18:25:00.000\nSTOP_TIME = 2026-10-03T18:30:00.000\nMETA_STOP\n2026-10-03T18:25:00.000  -3000.0  -1500.0  6300.0  -3.50  6.80  1.90\n2026-10-03T18:30:00.000  -3500.0  -500.0  6350.0  -3.60  6.90  1.20"
        }
      ],
      "valid": true
    },
    {
      "name": "refuses TIME_SYSTEM other than UTC in a later segment",
      "edits": [
        {
          "append": "META_START\nOBJECT_NAME = CASE-CHIPSET\nOBJECT_ID = UNKNOWN\nCENTER_NAME = EARTH\nREF_FRAME = GCRF\nTIME_SYSTEM = TAI\nSTART_TIME = 2026-10-03T18:25:00.000\nSTOP_TIME = 2026-10-03T18:30:00.000\nMETA_STOP\n2026-10-03T18:25:00.000  -3000.0  -1500.0  6300.0  -3.50  6.80  1.90\n2026-10-03T18:30:00.000  -3500.0  -500.0  6350.0  -3.60  6.90  1.20"
        }
      ],
      "valid": false,
      "errors_mention": ["TIME_SYSTEM", "segment 2"]
    },
    {
      "name": "refuses a START_TIME that is not the first epoch",
      "edits": [{ "replace": "START_TIME = 2026-10-03T18:05:00.000", "with": "START_TIME = 2026-10-03T18:04:00.000" }],
      "valid": false,
      "errors_mention": ["START_TIME", "first"]
    },
    {
      "name": "refuses a STOP_TIME that is not the last epoch",
      "edits": [{ "replace": "STOP_TIME = 2026-10-03T18:20:00.000", "with": "STOP_TIME = 2026-10-03T18:21:00.000" }],
      "valid": false,
      "errors_mention": ["STOP_TIME", "last"]
    },
    {
      "name": "refuses header keywords out of order",
      "edits": [
        { "replace": "ORIGINATOR = 3ROK", "with": null },
        {
          "replace": "CREATION_DATE = 2026-10-03T18:00:00",
          "with": "ORIGINATOR = 3ROK\nCREATION_DATE = 2026-10-03T18:00:00"
        }
      ],
      "valid": false,
      "errors_mention": ["out of order"]
    },
    {
      "name": "refuses metadata keywords out of order",
      "edits": [
        { "replace": "OBJECT_ID = UNKNOWN", "with": null },
        { "replace": "CENTER_NAME = EARTH", "with": "CENTER_NAME = EARTH\nOBJECT_ID = UNKNOWN" }
      ],
      "valid": false,
      "errors_mention": ["OBJECT_ID", "out of order"]
    },
    {
      "name": "refuses a missing required metadata keyword",
      "edits": [{ "replace": "OBJECT_NAME = CASE-CHIPSET", "with": null }],
      "valid": false,
      "errors_mention": ["OBJECT_NAME", "required"]
    },
    {
      "name": "refuses a missing META_STOP",
      "edits": [{ "replace": "META_STOP", "with": null }],
      "valid": false,
      "errors_mention": ["META_STOP"]
    },
    {
      "name": "refuses a wrong CCSDS_OEM_VERS",
      "edits": [{ "replace": "CCSDS_OEM_VERS = 3.0", "with": "CCSDS_OEM_VERS = 2.0" }],
      "valid": false,
      "errors_mention": ["CCSDS_OEM_VERS", "3.0"]
    },
    {
      "name": "refuses a covariance block",
      "edits": [
        {
          "append": "COVARIANCE_START\nEPOCH = 2026-10-03T18:05:00.000\n1.0\nCOVARIANCE_STOP"
        }
      ],
      "valid": false,
      "errors_mention": ["COVARIANCE"]
    },
    {
      "name": "refuses a token that is not a number",
      "edits": [
        {
          "replace": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10",
          "with": "2026-10-03T18:05:00.000  -1045.0  abc  3298.0  -1.20  3.40  6.10"
        }
      ],
      "valid": false,
      "errors_mention": ["abc", "not a number"]
    },
    {
      "name": "refuses a state line with the wrong number of values",
      "edits": [
        {
          "replace": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40  6.10",
          "with": "2026-10-03T18:05:00.000  -1045.0  -5512.0  3298.0  -1.20  3.40"
        }
      ],
      "valid": false,
      "errors_mention": ["6 numbers"]
    },
    {
      "name": "refuses an impossible calendar date",
      "edits": [
        { "replace": "START_TIME = 2026-10-03T18:05:00.000", "with": "START_TIME = 2026-02-30T18:05:00.000" }
      ],
      "valid": false,
      "errors_mention": ["START_TIME"]
    },
    {
      "name": "refuses a COMMENT in the middle of the header",
      "edits": [
        {
          "replace": "CREATION_DATE = 2026-10-03T18:00:00",
          "with": "CREATION_DATE = 2026-10-03T18:00:00\nCOMMENT too late"
        }
      ],
      "valid": false,
      "errors_mention": ["COMMENT", "directly after CCSDS_OEM_VERS"]
    }
  ]
}
