# Copy to .env.local for local work. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.
# Phase 0 and Phase 1 need none of them.

# Phase 3: Supabase Auth and Postgres.
# Both values are browser-safe by design. Row-level security protects the data.
# Supabase dashboard -> Project Settings -> API. The publishable key may also
# be the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 7: server only. The browser must never see this.
XAI_API_KEY=

# Phase 5: HTTPS streaming-HTTP or SSE URL of flight-mcp (https://<host>/mcp). Leave unset
# until deployed: the Grok route then leaves the MCP tool out and validates in-process.
FLIGHT_MCP_URL=
# Server only. The bearer token the deployed flight-mcp requires (its FLIGHT_MCP_TOKEN).
FLIGHT_MCP_TOKEN=

# Phase 8: browser imagery token, not a secret. Leave unset and the globe
# falls back to an ellipsoid with static imagery.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
