# Copy to .env.local for local work. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.
# Phase 0 and Phase 1 need none of them.

# Phase 3: Supabase Auth and Postgres.
# Both values are browser-safe by design. Row-level security protects the data.
# Supabase dashboard -> Project Settings -> API. The publishable key may also
# be the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 7: server only. The browser must never see any of these.
XAI_API_KEY=
# Builds a per-request collection of the case's train rows. Create it in the xAI console under
# Management Keys, with AddFileToCollection and the Collections endpoint group. Leave unset and the
# rows are sent inline, which works for a case up to 60 KB of train rows.
XAI_MANAGEMENT_API_KEY=
# Defaults to grok-4.7.
GROK_MODEL=
# Ask Grok spends xAI credits and sign-up is open. Comma-separated emails that may ask (empty means
# every signed-in account), and how many runs one account may start per hour (default 6).
GROK_ALLOWED_EMAILS=
GROK_RUNS_PER_HOUR=

# Phase 5: HTTPS streaming-HTTP or SSE URL of flight-mcp (https://<host>/mcp). Leave unset
# until deployed: the Grok route then leaves the MCP tool out and validates in-process.
FLIGHT_MCP_URL=
# Server only. The bearer token the deployed flight-mcp requires (its FLIGHT_MCP_TOKEN).
FLIGHT_MCP_TOKEN=

# Phase 8: browser imagery token, not a secret. Leave unset and the globe
# falls back to an ellipsoid with static imagery.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
